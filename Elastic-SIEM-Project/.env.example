# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit (placeholders only).

# --- Elasticsearch ---
ELASTIC_PASSWORD=change-me-strong-password
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Kibana ---
KIBANA_SYSTEM_PASSWORD=change-me-strong-password
# Generate with: openssl rand -base64 32
KIBANA_ENCRYPTION_KEY=change-me-32-byte-base64-key
KIBANA_SAVEDOBJECTS_KEY=change-me-32-byte-base64-key

# --- Stack ---
STACK_VERSION=8.12.2
CLUSTER_NAME=elastic-siem-cluster
MEM_LIMIT=1073741824  # 1GB in bytes

# --- IA agents / scripts ---
ES_HOST=http://localhost:9200
GEMINI_API_KEY=your-gemini-api-key-here

# --- Panel de supervisión: autenticación (API-01) ---
# Clave de firma de la cookie de sesión. SIN VALOR POR DEFECTO A PROPÓSITO: el
# panel NO ARRANCA si falta. Un default haría que todos los despliegues firmaran
# sus cookies con la misma clave.
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generar-una-clave-propia-de-al-menos-32-caracteres

# Almacén de usuarios (gitignored, permisos 0600). Se gestiona con:
#     python3 manage_users.py crear <nombre> --rol analyst
SIEM_USERS_FILE=users.json

# Poner en true solo si el panel se sirve por HTTPS: activa el flag `Secure` de
# la cookie. Sobre HTTP impediría el login.
SIEM_TLS=false

# NOTA: ANALYST_NAME fue ELIMINADA. El campo `analyst` del registro inmutable
# sale ahora de la sesión autenticada, no del entorno: quien corría el proceso
# decidía qué nombre firmaba cada decisión (hallazgo API-01).
