# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit (placeholders only).

# --- Elasticsearch ---
ELASTIC_PASSWORD=change-me-strong-password
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Kibana ---
KIBANA_SYSTEM_PASSWORD=change-me-strong-password
# Generate with: openssl rand -base64 32
KIBANA_ENCRYPTION_KEY=change-me-32-byte-base64-key
KIBANA_SAVEDOBJECTS_KEY=change-me-32-byte-base64-key

# --- Stack ---
STACK_VERSION=8.12.2
CLUSTER_NAME=elastic-siem-cluster

# --- Capa IA (microservicios) ---
# Token interno entre microservicios. SIN VALOR POR DEFECTO A PROPÓSITO: ningún
# servicio arranca sin él (mínimo 32 caracteres). start.sh lo genera si falta.
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SIEM_INTERNAL_TOKEN=generar-un-token-propio-de-al-menos-32-caracteres

# ES_HOST solo lo usan las herramientas corridas FUERA de Docker. Dentro, el
# collector usa SIEM_ES_HOST (por defecto http://elasticsearch:9200): cambiarla
# apunta el SIEM a otro cluster sin reconstruir nada (RNF-PORT-05).
ES_HOST=http://localhost:9200
# SIEM_ES_HOST=https://otro-cluster:9200

# --- Umbrales y ventana de detección (RNF-MANT-04) ---
# Se aplican con `docker compose up -d classifier collector` (sin --build).
# Un valor inválido hace que el servicio no arranque y diga por qué.
SIEM_UMBRAL_FUERZA_BRUTA=20     # fallos de auth para confirmar fuerza bruta
SIEM_UMBRAL_CRITICO=5000        # fallos para subir la severidad a crítica (> el anterior)
SIEM_UMBRAL_PUERTOS=10          # puertos distintos para confirmar un port scan
SIEM_VENTANA=24h                # ventana de análisis: número + m, h o d (90m, 24h, 7d)
GEMINI_API_KEY=your-gemini-api-key-here
# Interruptor del Agente 2, aparte de la key: aunque GEMINI_API_KEY esté
# completa, el Agente 2 usa el fallback determinístico salvo que esto diga
# "true". Así la key puede quedar guardada sin gastar tokens hasta que se
# active a propósito. Conseguir una key gratis: https://aistudio.google.com/apikey
SIEM_USE_LLM=false

# Corrida automática del pipeline, en segundos (0 = solo a mano con
# ./scripts/siem.sh pipeline). Mínimo 30. OJO: con SIEM_USE_LLM=true, cada
# corrida llama a Gemini una vez por incidente.
SIEM_PIPELINE_INTERVALO=120

# --- Respaldos (RQ-SEC-05) y retención (RQ-SEC-17) ---
# Clave de cifrado de los respaldos (≥ 32 caracteres). start.sh la genera si
# falta. GUARDAR UNA COPIA FUERA DEL EQUIPO: sin ella no se restaura nada.
SIEM_RESPALDO_CLAVE=generar-una-clave-propia-de-al-menos-32-caracteres
SIEM_RESPALDO_HORA=03:00        # hora local (TZ) del respaldo diario
SIEM_RESPALDO_RETENCION=7       # cuántos respaldos diarios se conservan
# Dónde quedan los respaldos cifrados. Idealmente OTRO disco o un montaje de red:
# un respaldo en el mismo disco no sobrevive a perder el disco.
# SIEM_RESPALDO_DIR=/mnt/respaldos/siem
TZ=America/Argentina/Buenos_Aires
# Días que se conservan los índices con datos personales (IPs, usuarios).
# Se aplica con ./scripts/deploy-ilm.sh (lo corre start.sh).
SIEM_RETENCION_DIAS=30

# --- Panel de supervisión: autenticación (API-01) ---
# Clave de firma de la cookie de sesión. SIN VALOR POR DEFECTO A PROPÓSITO: el
# panel NO ARRANCA si falta. Un default haría que todos los despliegues firmaran
# sus cookies con la misma clave.
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generar-una-clave-propia-de-al-menos-32-caracteres

# Almacén de usuarios (permisos 0600), en el volumen del servicio auth. Se gestiona con:
#     ./scripts/siem.sh usuarios crear <nombre> --rol analyst
# (Dentro del contenedor, docker-compose.yml fija la ruta; esta es la del host.)
SIEM_USERS_FILE=data/auth/users.json

# Poner en true solo si el panel se sirve por HTTPS: activa el flag `Secure` de
# la cookie. Sobre HTTP impediría el login.
SIEM_TLS=false

# NOTA: ANALYST_NAME fue ELIMINADA. El campo `analyst` del registro inmutable
# sale ahora de la sesión autenticada, no del entorno: quien corría el proceso
# decidía qué nombre firmaba cada decisión (hallazgo API-01).
